# === Gmail (IMAP + Uygulama Şifresi) ===
# Google Cloud GEREKMEZ. Adımlar:
#   1) 2 Adımlı Doğrulamayı aç: https://myaccount.google.com/signinoptions/twosv
#   2) Uygulama Şifresi üret:    https://myaccount.google.com/apppasswords
#   NOT: Normal Gmail şifren DEĞİL, bu 16 haneli uygulama şifresi.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=ornek@gmail.com
IMAP_PASSWORD=16-haneli-uygulama-sifresi
IMAP_FOLDER=INBOX
# Hangi mailler taransın:
#   UNSEEN  -> sadece okunmamışlar (önerilen)
#   ALL     -> son N gündeki tüm mailler
IMAP_SEARCH=UNSEEN
# Kaç gün geriye bakılsın:
LOOKBACK_DAYS=2

# === Gemini API (ÜCRETSIZ) ===
# Anahtarı buradan al (kredi kartı gerekmez): https://aistudio.google.com/apikey
# NOT: "Gemini Plus/Advanced" aboneliği DEĞİL — ayrı, ücretsiz bir API anahtarı.
GEMINI_API_KEY=...
# Ücretsiz katmanda hızlı model:
GEMINI_MODEL=gemini-2.0-flash
# Bu skorun (1-5) üstündekiler "önemli" sayılır ve bildirim gönderilir:
IMPORTANCE_THRESHOLD=3

# === Telegram bildirimi ===
# 1) @BotFather ile bot oluştur -> token al
# 2) Botuna bir mesaj at, sonra:
#    https://api.telegram.org/bot<TOKEN>/getUpdates  -> chat id'yi gör
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789
